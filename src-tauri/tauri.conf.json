{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quick-rec",
  "version": "1.0.0",
  "identifier": "com.hao.quickrec",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Quick Rec - History Vault",
        "label": "main",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$HOME/.local/**/*",
          "$HOME/Videos/**/*",
          "$APPDATA/**/*",
          "$RESOURCE/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
