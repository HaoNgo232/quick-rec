#!/usr/bin/env python3
import sys
import os
import math
import shutil
import subprocess
import signal
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Pango', '1.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo
import cairo

class RecordingOverlay(Gtk.Window):
    def __init__(self, x, y, w, h, ffmpeg_pid=None):
        super().__init__(type=Gtk.WindowType.POPUP)
        
        self.area_x = int(x)
        self.area_y = int(y)
        self.area_w = int(w)
        self.area_h = int(h)
        self.ffmpeg_pid = ffmpeg_pid
        
        self.border_width = 2
        self.badge_w = 286
        self.badge_h = 36
        self.spacing = 8
        self.corner_len = min(22, max(10, self.area_w // 8), max(10, self.area_h // 8))
        
        # Screen geometry detection for anti-overflow clamping
        display = Gdk.Display.get_default()
        screen_x, screen_y, screen_w, screen_h = 0, 0, 1920, 1080
        if display:
            monitor = display.get_primary_monitor() or (display.get_monitor(0) if display.get_n_monitors() > 0 else None)
            if monitor:
                geom = monitor.get_geometry()
                screen_x, screen_y = geom.x, geom.y
                screen_w, screen_h = geom.width, geom.height

        area_total_w = self.area_w + 2 * self.border_width
        area_total_h = self.area_h + 2 * self.border_width

        # Calculate horizontal centering for badge relative to area
        if area_total_w >= self.badge_w:
            self.win_x = self.area_x - self.border_width
            self.badge_x = (area_total_w - self.badge_w) // 2
            self.frame_x = 0
            self.win_w = area_total_w
        else:
            diff = self.badge_w - area_total_w
            self.win_x = self.area_x - self.border_width - (diff // 2)
            self.badge_x = 0
            self.frame_x = diff // 2
            self.win_w = self.badge_w

        # Check available vertical space outside the recording region
        req_space = self.badge_h + self.spacing + self.border_width
        space_above = (self.area_y - self.border_width) - screen_y
        space_below = (screen_y + screen_h) - (self.area_y + self.area_h + self.border_width)

        if space_above >= req_space:
            # Outset Mode Above
            self.win_y = self.area_y - self.border_width - self.badge_h - self.spacing
            self.badge_y = 0
            self.frame_y = self.badge_h + self.spacing
            self.win_h = area_total_h + self.badge_h + self.spacing
        elif space_below >= req_space:
            # Outset Mode Below
            self.win_y = self.area_y - self.border_width
            self.frame_y = 0
            self.badge_y = area_total_h + self.spacing
            self.win_h = area_total_h + self.badge_h + self.spacing
        else:
            # Dynamic Inset Mode (Fullscreen or edge-to-edge captures)
            # Anchor HUD at Top-Center inside the recording region with safe margin
            self.win_y = max(screen_y, self.area_y - self.border_width)
            self.frame_y = 0
            self.badge_y = 12  # 12px from top edge
            self.win_h = area_total_h

        # Strict viewport boundary clamping
        self.win_x = max(screen_x, min(self.win_x, screen_x + screen_w - self.win_w))
        
        # GTK Window Setup
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
            
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK | 
            Gdk.EventMask.POINTER_MOTION_MASK | 
            Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_click)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("leave-notify-event", self.on_leave)
        
        # Animation & Timing
        self.seconds = 0
        self.pulse_phase = 0.0
        self.is_hover_stop = False
        
        self.realize()
        self.move(int(self.win_x), int(self.win_y))
        self.resize(int(self.win_w), int(self.win_h))
        
        # Shape input region to badge only (click-through anywhere else)
        gdk_win = self.get_window()
        badge_region = cairo.Region(cairo.RectangleInt(
            int(self.badge_x), int(self.badge_y), int(self.badge_w), int(self.badge_h)
        ))
        gdk_win.input_shape_combine_region(badge_region, 0, 0)
        
        # Smooth pulse animation (50ms interval) & 1s second tracker
        GLib.timeout_add(50, self.on_animation_tick)
        GLib.timeout_add_seconds(1, self.on_timer_tick)
        GLib.timeout_add(500, self.check_ffmpeg)
        
    def check_ffmpeg(self):
        if self.ffmpeg_pid:
            try:
                os.kill(self.ffmpeg_pid, 0)
            except OSError:
                Gtk.main_quit()
                return False
        return True

    def on_animation_tick(self):
        self.pulse_phase = (self.pulse_phase + 0.12) % (2 * math.pi)
        # Redraw only the badge area for ultra-low CPU consumption
        self.queue_draw_area(int(self.badge_x), int(self.badge_y), int(self.badge_w), int(self.badge_h))
        return True

    def on_timer_tick(self):
        self.seconds += 1
        return True

    def _get_stop_button_rect(self):
        btn_w = 78
        btn_h = 24
        btn_x = self.badge_x + self.badge_w - btn_w - 6
        btn_y = self.badge_y + (self.badge_h - btn_h) / 2.0
        return btn_x, btn_y, btn_w, btn_h

    def on_motion(self, widget, event):
        bx, by, bw, bh = self._get_stop_button_rect()
        hovering = (bx <= event.x <= bx + bw and by <= event.y <= by + bh)
        if hovering != self.is_hover_stop:
            self.is_hover_stop = hovering
            gdk_win = self.get_window()
            if gdk_win:
                cursor = Gdk.Cursor.new_from_name(self.get_display(), "pointer") if hovering else None
                gdk_win.set_cursor(cursor)
            self.queue_draw_area(int(self.badge_x), int(self.badge_y), int(self.badge_w), int(self.badge_h))
        return False

    def on_leave(self, widget, event):
        if self.is_hover_stop:
            self.is_hover_stop = False
            gdk_win = self.get_window()
            if gdk_win:
                gdk_win.set_cursor(None)
            self.queue_draw_area(int(self.badge_x), int(self.badge_y), int(self.badge_w), int(self.badge_h))
        return False

    def on_click(self, widget, event):
        if event.button == 1:
            quick_rec = shutil.which("quick-rec") or "/usr/bin/quick-rec"
            if not os.path.exists(quick_rec):
                quick_rec = os.path.expanduser("~/.local/bin/quick-rec")
            
            if os.path.exists(quick_rec):
                try:
                    subprocess.Popen([quick_rec, "--toggle"])
                    return True
                except Exception:
                    pass

            if self.ffmpeg_pid:
                try:
                    os.kill(self.ffmpeg_pid, signal.SIGINT)
                except OSError:
                    pass
            return True
        return False

    def _draw_rounded_rect(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def on_draw(self, widget, cr):
        # Clear transparent buffer
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        
        # 1. VIEW FINDER RECORDING FRAME
        fx = self.frame_x + self.border_width / 2.0
        fy = self.frame_y + self.border_width / 2.0
        fw = self.area_w + self.border_width
        fh = self.area_h + self.border_width
        
        # 1a. Thin precision hairline boundary
        cr.set_source_rgba(0.94, 0.25, 0.25, 0.65)
        cr.set_line_width(1.2)
        cr.rectangle(fx, fy, fw, fh)
        cr.stroke()

        # 1b. Prominent Viewfinder Corner Brackets
        clen = self.corner_len
        cr.set_source_rgba(0.98, 0.20, 0.20, 1.0)
        cr.set_line_width(3.0)
        cr.set_line_cap(cairo.LINE_CAP_SQUARE)
        cr.set_line_join(cairo.LINE_JOIN_MITER)

        # Top-Left Corner
        cr.move_to(fx, fy + clen)
        cr.line_to(fx, fy)
        cr.line_to(fx + clen, fy)
        cr.stroke()

        # Top-Right Corner
        cr.move_to(fx + fw - clen, fy)
        cr.line_to(fx + fw, fy)
        cr.line_to(fx + fw, fy + clen)
        cr.stroke()

        # Bottom-Right Corner
        cr.move_to(fx + fw, fy + fh - clen)
        cr.line_to(fx + fw, fy + fh)
        cr.line_to(fx + fw - clen, fy + fh)
        cr.stroke()

        # Bottom-Left Corner
        cr.move_to(fx + clen, fy + fh)
        cr.line_to(fx, fy + fh)
        cr.line_to(fx, fy + fh - clen)
        cr.stroke()
        
        # 2. FLOATING CONTROL PILL HUD
        bx = self.badge_x
        by = self.badge_y
        bw = self.badge_w
        bh = self.badge_h
        radius = bh / 2.0
        
        # Pill Background (Deep obsidian glass)
        self._draw_rounded_rect(cr, bx, by, bw, bh, radius)
        cr.set_source_rgba(0.06, 0.07, 0.09, 0.95)
        cr.fill_preserve()
        
        # Subtle micro-bezel border
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12)
        cr.set_line_width(1.0)
        cr.stroke()
        
        # 2a. Pulsing REC Breathing Circle
        pulse_val = (math.sin(self.pulse_phase) + 1.0) / 2.0  # 0.0 to 1.0
        dot_x = bx + 16
        dot_y = by + bh / 2.0
        
        # Outer soft glow halo
        halo_alpha = 0.12 + 0.22 * pulse_val
        cr.set_source_rgba(0.95, 0.22, 0.22, halo_alpha)
        cr.arc(dot_x, dot_y, 7.5, 0, 2 * math.pi)
        cr.fill()
        
        # Inner vibrant core
        cr.set_source_rgba(0.95, 0.22, 0.22, 1.0)
        cr.arc(dot_x, dot_y, 4.5, 0, 2 * math.pi)
        cr.fill()
        
        # 2b. Tabular Timer
        mins = self.seconds // 60
        secs = self.seconds % 60
        time_str = f"{mins:02d}:{secs:02d}"
        
        layout = self.create_pango_layout()
        layout.set_markup(f"<span font='Monospace Semi-Bold 10' color='#f4f4f5'>{time_str}</span>")
        cr.move_to(bx + 28, by + 9)
        PangoCairo.show_layout(cr, layout)
        
        # 2c. Hairline Separator 1
        sep1_x = bx + 78
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.14)
        cr.set_line_width(1.0)
        cr.move_to(sep1_x, by + 10)
        cr.line_to(sep1_x, by + bh - 10)
        cr.stroke()

        # 2d. Resolution Chip
        res_layout = self.create_pango_layout()
        res_layout.set_markup(f"<span font='Sans Medium 8.5' color='#a1a1aa'>{self.area_w}×{self.area_h}</span>")
        cr.move_to(bx + 86, by + 11)
        PangoCairo.show_layout(cr, res_layout)

        # 2e. Hairline Separator 2
        sep2_x = bx + 192
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.14)
        cr.set_line_width(1.0)
        cr.move_to(sep2_x, by + 10)
        cr.line_to(sep2_x, by + bh - 10)
        cr.stroke()

        # 2f. Dedicated Stop Action Pill Button
        btn_x, btn_y, btn_w, btn_h = self._get_stop_button_rect()
        btn_r = btn_h / 2.0
        self._draw_rounded_rect(cr, btn_x, btn_y, btn_w, btn_h, btn_r)
        
        if self.is_hover_stop:
            cr.set_source_rgba(0.95, 0.20, 0.20, 1.0)  # Bright crimson on hover
        else:
            cr.set_source_rgba(0.85, 0.15, 0.15, 0.94)  # Solid dark crimson
        cr.fill_preserve()
        
        # Border around button
        cr.set_source_rgba(1.0, 0.4, 0.4, 0.35 if self.is_hover_stop else 0.2)
        cr.set_line_width(1.0)
        cr.stroke()

        # White square Stop icon inside button
        sq_x = btn_x + 12
        sq_y = btn_y + 8
        sq_s = 8
        self._draw_rounded_rect(cr, sq_x, sq_y, sq_s, sq_s, 1.5)
        cr.set_source_rgba(1.0, 1.0, 1.0, 1.0)
        cr.fill()

        # Stop button text
        stop_layout = self.create_pango_layout()
        stop_layout.set_markup("<span font='Sans Bold 8.5' color='white'>STOP</span>")
        cr.move_to(btn_x + 26, btn_y + 5.5)
        PangoCairo.show_layout(cr, stop_layout)
        
        return False

def main():
    if len(sys.argv) < 5:
        sys.exit(1)
    x = int(sys.argv[1])
    y = int(sys.argv[2])
    w = int(sys.argv[3])
    h = int(sys.argv[4])
    ffmpeg_pid = int(sys.argv[5]) if len(sys.argv) > 5 else None
    
    signal.signal(signal.SIGTERM, lambda *args: Gtk.main_quit())
    signal.signal(signal.SIGINT, lambda *args: Gtk.main_quit())
    
    overlay = RecordingOverlay(x, y, w, h, ffmpeg_pid)
    overlay.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
